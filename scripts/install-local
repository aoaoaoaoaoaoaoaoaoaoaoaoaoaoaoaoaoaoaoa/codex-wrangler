#!/bin/sh
set -eu

if [ -x /usr/bin/codex-wrangler ]; then
  printf '%s\n' \
    'install-local refused: /usr/bin/codex-wrangler owns this system; refresh its package instead' >&2
  exit 69
fi

cargo build --release --bin codex-wrangler
target_directory=$(cargo metadata --format-version 1 --no-deps \
  | sed -n 's/.*"target_directory":"\([^"]*\)".*/\1/p')
test -n "$target_directory"
install -Dm755 "$target_directory/release/codex-wrangler" \
  "$HOME/.local/bin/codex-wrangler"
"$HOME/.local/bin/codex-wrangler" install
