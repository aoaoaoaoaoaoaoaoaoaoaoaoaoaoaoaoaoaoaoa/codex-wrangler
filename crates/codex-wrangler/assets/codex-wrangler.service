[Unit]
Description=Codex Wrangler resident session gallery
ConditionEnvironment=DISPLAY
PartOf=x11-apps.target
After=x11-apps.target

[Service]
Type=simple
Environment="PATH=%h/.local/bin:%h/bin:/usr/local/bin:/usr/bin"
ExecStart=@WRANGLER@ --resident
Restart=on-failure
RestartSec=2s

[Install]
WantedBy=x11-apps.target
